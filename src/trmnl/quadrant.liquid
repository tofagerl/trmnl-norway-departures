<div class="layout">
  <div class="columns">
    <div class="column" data-overflow-max-cols="1" data-overflow-counter="true">
      {{ oslo_banner }}
      {% if line_count > 0 %}
        {% for departure in departures %}
          <div class="item">
            <div class="meta">
              <span class="index">{{ departure[0] }}</span>
            </div>
            <div class="content">
              {% for dest in departure[1] %}
                {% assign parts = dest[0] | split: " - " %}
                <span class="title title--small" data-clamp="1">{{ parts[0] }}</span>
                <div class="flex flex--row flex--wrap gap--small">
                  {% for time in dest[1] %}
                    {% assign hhmm = time.expected | split: "." %}
                    <span class="label label--small label--underline">{{ hhmm[0] }}</span>
                  {% endfor %}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="label">No departures</span>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg">
  <span class="title" data-clamp="1">{{ name | default: "Departures" }}</span>
  <span class="instance">{{ last_updated }}</span>
</div>
